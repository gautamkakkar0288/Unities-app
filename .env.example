# ---------------------------------------------------------------------------
# Cirqles mobile — local configuration template
# ---------------------------------------------------------------------------
# Flutter does not read .env files at runtime in this project. Configuration is
# passed to the compiler with --dart-define so that no configuration file is
# ever bundled into a release artifact by accident.
#
# Copy this file to `.env` (git-ignored) and use it as the source for the
# --dart-define flags documented in README.md, or feed it to your IDE launch
# configuration.
#
# NEVER put a private key, production credential, signing secret or access
# token in this file or in any --dart-define. The mobile client is a public
# binary; anything compiled into it is readable by anyone who downloads it.
# ---------------------------------------------------------------------------

# Base URL of the Cirqles web/backend deployment this build talks to.
# Android emulator reaches the host machine on 10.0.2.2, iOS simulator on
# localhost. There is no default production URL on purpose.
CIRQLES_API_BASE_URL=http://10.0.2.2:3000

# development | staging | production
# Controls verbose logging defaults and the in-app environment banner.
CIRQLES_ENV=development

# Feature flags. All default to false so a flag has to be turned on
# deliberately, per environment.
CIRQLES_FEATURE_COMMUNITIES=false
CIRQLES_FEATURE_SEARCH=false
CIRQLES_FEATURE_CREATE=false

# When true, screens whose backend endpoint does not exist yet render clearly
# labelled sample content instead of an empty state. Never enable in a release
# build: it makes the app look finished when it is not.
CIRQLES_USE_SAMPLE_CONTENT=false

# Analytics. No provider is wired up yet; the flag exists so the consent and
# transport work has a home and is off by default.
CIRQLES_ANALYTICS_ENABLED=false

# Push notifications. The backend has an in-app notifications table but no
# device-token endpoint yet (see ARCHITECTURE.md § Backend gaps), so this stays
# off until that exists.
CIRQLES_PUSH_ENABLED=false

# Verbose network/auth logging. Defaults to on in development builds.
CIRQLES_VERBOSE_LOGGING=true
